# Copier ce fichier en .env.local (local) ou le saisir dans les variables d'environnement de Vercel.
# Ne jamais committer de vraies valeurs.

# URL publique de l'API art-malagasy-back, avec /api/v1 et sans slash final.
API_URL=https://VOTRE-BACK.exemple.com/api/v1

# Origine du back qui sert les photos importées (/files/...), sans slash final.
FILES_URL=https://VOTRE-BACK.exemple.com

# Exactement la même valeur que JWT_SECRET dans le config.env du back.
# Sert uniquement à vérifier la signature du token de connexion.
JWT_SECRET=

# Facultatif : taux de conversion indicatifs pour l'affichage des prix (ariary pour 1 unité).
# Les commandes restent enregistrées et facturées en ariary.
NEXT_PUBLIC_RATE_EUR=5100
NEXT_PUBLIC_RATE_USD=4500
